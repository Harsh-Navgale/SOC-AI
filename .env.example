# ---- MongoDB ----
MONGO_USER=socadmin
MONGO_PASSWORD=change_me_mongo
MONGO_URI=mongodb://socadmin:change_me_mongo@mongodb:27017
MONGO_DB=soc_ai

# ---- ChromaDB (Vector DB) ----
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# ---- Bedrock zero-config defaults ----
# Used only when an admin hasn't set a default model in Settings yet (a connected Bedrock
# session is still required for either to actually serve a request).
DEFAULT_BEDROCK_CHAT_MODEL=anthropic.claude-haiku-4-5-v1:0
DEFAULT_BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0

# ---- Wazuh Indexer (your real manager/indexer — fill in when available) ----
# Until these are set correctly, the backend logs warnings and keeps retrying;
# it will not crash and the rest of the stack works fine without it.
WAZUH_INDEXER_HOST=https://your-wazuh-indexer:9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASSWORD=change_me_wazuh_indexer_password
WAZUH_INDEX_PATTERN=wazuh-alerts-*
# Set to "false" only for a lab indexer with a self-signed cert you trust.
WAZUH_INDEXER_VERIFY_SSL=true
# Optional path (inside the backend container) to a CA bundle for a private CA.
WAZUH_CA_BUNDLE=

# ---- Wazuh Manager API (separate service from the indexer above, port 55000) ----
# Used only for the System Health dashboard (agent counts, manager version).
WAZUH_MANAGER_HOST=https://your-wazuh-manager:55000
WAZUH_MANAGER_USER=wazuh-wui
WAZUH_MANAGER_PASSWORD=change_me_wazuh_manager_password
WAZUH_MANAGER_VERIFY_SSL=true

# ---- S3 asset inventory (compared against Wazuh agents on the Asset Coverage page) ----
# AWS credentials themselves are NOT set here — they're entered at runtime from the
# Asset Coverage page (admin only) and held in the backend's memory for 12h, never
# written to disk. Only non-secret config lives here. Picking "latest object in the bucket"
# uses the same rule as ~/Automations/S3/s3_daily_digest.py (most recently modified,
# skipping zero-size objects) for consistency with that existing automation.
AWS_DEFAULT_REGION=us-east-1
S3_INVENTORY_BUCKET=
S3_INVENTORY_PREFIX=
# Optional: set this instead of PREFIX if your inventory is always written to one fixed key
# (e.g. "inventory/latest.json"). If unset, the most-recently-modified object under
# S3_INVENTORY_PREFIX is used (empty prefix = whole bucket).
S3_INVENTORY_KEY=
# One of: csv | json (array of objects) | ndjson (one JSON object per line)
S3_INVENTORY_FORMAT=csv
# Field name in each inventory record that holds the hostname — display-only (shown in
# tables), NOT used for matching. A few common alternates are tried automatically as a
# fallback (Hostname, host_name, name, instance_name).
S3_INVENTORY_HOSTNAME_FIELD=hostname
# Field name that holds the IP address — this IS the actual match key against Wazuh agent
# IPs (asset_coverage.py matches purely on IP, not hostname). A few common alternates are
# tried automatically (IP, ip_address, PrivateIpAddress, private_ip).
S3_INVENTORY_IP_FIELD=ip

# ---- Correlation tuning ----
CORRELATION_WINDOW_SECONDS=300
CORRELATION_THRESHOLD=5

# ---- Data retention ----
RAW_ALERT_RETENTION_DAYS=30

# ---- Auth ----
# Generated automatically by scripts/setup.sh on first run — do not hand-edit
# unless you know what you're doing. ADMIN_USERNAME/ADMIN_PASSWORD are only used
# once, to bootstrap the first admin user into MongoDB when the `users` collection
# is empty — after that, accounts are managed from the Users tab (admin only) and
# these env vars have no further effect.
JWT_SECRET=change_me_jwt_secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin_password
